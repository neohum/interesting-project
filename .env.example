# Agent Harness Environment Contract (.env.example)
# Copy this file to .env and configure only the integrations your project needs.

# --- Jev (System One) Content-Aware Risk & Sensitivity Layer ---
FRAMEIN_JEV=off
JEV_ENABLED=false
FRAMEIN_JEV_BACKEND=auto
JEV_PROVIDER=typesafe
JEV_MODEL=jev-1.13.0
TYPESAFE_API_KEY=
JEV_TIMEOUT_MS=10000
FRAMEIN_JEV_THRESHOLD=0.45

# --- Sandbox & Autonomous Loop Safety ---
HARNESS_SANDBOX_MODE=docker
PERSONA_APPROVE=on
PERSONA_APPROVE_THRESHOLD=0.8

# --- Optional Delivery & Notifications ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_TO_EMAIL=
